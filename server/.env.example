# AgentScratch local LLM configuration
# Copy this file to .env and load it before starting the backend.

# OpenAI-compatible endpoint. Examples:
# llama.cpp:  http://127.0.0.1:8080/v1
# Ollama:    http://127.0.0.1:11434/v1
AGENTSCRATCH_LLM_BASE_URL=http://127.0.0.1:8080/v1
AGENTSCRATCH_LLM_MODEL=qwen-tiny
AGENTSCRATCH_LLM_API_KEY=local
AGENTSCRATCH_LLM_TIMEOUT=60
# SQLite file path. Use :memory: for an ephemeral development session.
AGENTSCRATCH_DB_PATH=agentscratch.db
